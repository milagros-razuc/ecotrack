# Copy to backend/.env.local. Keep credentials for local development only.
MQTT_USER=backend
MQTT_PASS=replace-with-local-password
MQTT_CA_PATH=/run/secrets/ecotrack-ca.crt
DYNSEC_CA_PATH=/run/secrets/ecotrack-ca.crt
PORT=3000
JWT_SECRET=replace-with-a-long-random-local-secret
NODE_ENV=development
ADMIN_USER=admin
ADMIN_PASS=replace-with-local-password
ADMIN_NOMBRE=Administrador
