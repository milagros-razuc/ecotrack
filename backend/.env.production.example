# Copy to backend/.env.production on the VM. Never commit real credentials.
MQTT_USER=backend
MQTT_PASS=replace-with-long-random-password
MQTT_CA_PATH=/run/secrets/ecotrack-ca.crt
DYNSEC_CA_PATH=/run/secrets/ecotrack-ca.crt
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
ADMIN_USER=admin
ADMIN_PASS=replace-with-long-random-password
ADMIN_NOMBRE=Administrador
CORS_ORIGIN=https://app.ecotrack.ar
