# Copy to .env.production on the VM. Never commit the copied file or real credentials.
POSTGRES_DB=ecotrack
POSTGRES_USER=ecotrack
POSTGRES_PASSWORD=replace-with-long-random-password
WEB_PUBLIC_HOST=app.ecotrack.ar
MQTT_PUBLIC_HOST=mqtt.ecotrack.ar
DYNSEC_ADMIN_USER=ecotrack-dynsec-admin
DYNSEC_ADMIN_PASS=replace-with-long-random-password
CORS_ORIGIN=https://app.ecotrack.ar
BACKEND_ENV_FILE=./backend/.env.production
CADDYFILE_PATH=./caddy/Caddyfile.production
MOSQUITTO_CERTS_DIR=./deploy/certs/mosquitto/config/certs
